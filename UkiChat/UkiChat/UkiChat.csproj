<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <AssemblyVersion>0.6.3.0</AssemblyVersion>
        <FileVersion>0.6.3.0</FileVersion>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Centrifugal.Centrifuge" Version="0.0.13" />
      <PackageReference Include="DryIoc.Microsoft.DependencyInjection" Version="6.2.0" />
      <PackageReference Include="Google.Protobuf" Version="3.33.5" />
      <PackageReference Include="Grpc.Tools" Version="2.76.0">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="LiteDB" Version="5.0.21" />
      <PackageReference Include="Microsoft.AspNetCore.App" Version="2.2.8" />
      <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
      <PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="1.2.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
      <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
      <PackageReference Include="MahApps.Metro" Version="2.4.11" />
      <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="5.0.0" />
      <PackageReference Include="Prism.DryIoc" Version="9.0.537" />
      <PackageReference Include="Prism.Wpf" Version="9.0.537" />
      <PackageReference Include="Scrutor" Version="7.0.0" />
      <PackageReference Include="Serilog" Version="4.3.1" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="Tomlyn" Version="0.19.0" />
      <PackageReference Include="TwitchLib.Api" Version="3.10.2" />
      <PackageReference Include="TwitchLib.Client" Version="4.0.1" />
      <PackageReference Include="TwitchLib.EventSub.Websockets" Version="0.8.0" />
    </ItemGroup>

    <ItemGroup>
       <!-- wwwroot генерируется во время сборки (см. таргет BuildNuxtFrontend), поэтому
            стандартное копирование по глобу здесь не годится: список файлов вычисляется
            до генерации. Копируем отдельным таргетом CopyNuxtWwwroot. -->
       <None Remove="wwwroot\**\*" />
       <None Update="Localization\en.json">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
       </None>
       <None Update="Localization\ru.json">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
       </None>
    </ItemGroup>

    <ItemGroup>      
      <None Remove="app-settings.local.toml" />
      <EmbeddedResource Include="app-settings.local.toml" />
    </ItemGroup>

    <ItemGroup>
      <Protobuf Include="Protos\centrifuge_client.proto" GrpcServices="None" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Assets\icon.ico" />
      <Resource Include="Assets\icon.ico" />
      <None Remove="Assets\icon.png" />
    </ItemGroup>

    <!-- ============================================================
         Автосборка фронтенда (nuxt generate) перед сборкой проекта.
         - Пересобирается только если изменились исходники фронта (Inputs/Outputs).
         - Пропускается, если запущен dev-сервер Nuxt на :3000 — чтобы не мешать
           работе с фронтом через http://localhost:3000 и не тратить время на билд.
         - Можно отключить вручную: dotnet build -p:SkipWebBuild=true
         ============================================================ -->
    <PropertyGroup>
        <WebProjectDir>$(MSBuildProjectDirectory)\..\..\ukichat-web</WebProjectDir>
    </PropertyGroup>

    <ItemGroup>
        <NuxtSource Include="$(WebProjectDir)\app\**\*" />
        <NuxtSource Include="$(WebProjectDir)\public\**\*" />
    </ItemGroup>

    <Target Name="BuildNuxtFrontend"
            BeforeTargets="BeforeBuild"
            Condition="'$(SkipWebBuild)' != 'true'"
            Inputs="@(NuxtSource);$(WebProjectDir)\nuxt.config.ts;$(WebProjectDir)\package.json;$(WebProjectDir)\pnpm-lock.yaml"
            Outputs="wwwroot\index.html">
        <!-- Ищем LISTENING на порту 3000. ExitCode 0 = dev-сервер запущен.
             Без -p TCP: Vite слушает IPv6 (::1), а -p TCP показывает только IPv4. -->
        <Exec Command="netstat -an | findstr /R /C:&quot;:3000 .*LISTENING&quot;"
              IgnoreExitCode="true"
              StandardOutputImportance="low"
              StandardErrorImportance="low">
            <Output TaskParameter="ExitCode" PropertyName="NuxtDevServerCheckExitCode" />
        </Exec>
        <PropertyGroup>
            <NuxtDevServerRunning Condition="'$(NuxtDevServerCheckExitCode)' == '0'">true</NuxtDevServerRunning>
        </PropertyGroup>

        <Message Condition="'$(NuxtDevServerRunning)' == 'true'" Importance="high"
                 Text="Nuxt dev-сервер слушает :3000 — 'pnpm generate' пропущен, wwwroot не тронут." />

        <Exec Command="pnpm install" WorkingDirectory="$(WebProjectDir)"
              Condition="'$(NuxtDevServerRunning)' != 'true' And !Exists('$(WebProjectDir)\node_modules')" />
        <Message Condition="'$(NuxtDevServerRunning)' != 'true'" Importance="high"
                 Text="Собираем фронтенд: pnpm generate -> wwwroot" />
        <Exec Command="pnpm generate" WorkingDirectory="$(WebProjectDir)"
              Condition="'$(NuxtDevServerRunning)' != 'true'" />
        <PropertyGroup>
            <NuxtWasRegenerated Condition="'$(NuxtDevServerRunning)' != 'true'">true</NuxtWasRegenerated>
        </PropertyGroup>
    </Target>

    <!-- Копируем wwwroot в каталог сборки. Список файлов вычисляется в момент
         выполнения таргета, т.е. уже после nuxt generate. -->
    <Target Name="CopyNuxtWwwroot" BeforeTargets="BeforeBuild" DependsOnTargets="BuildNuxtFrontend">
        <!-- После пересборки фронта имена хэшированных файлов меняются — чистим старые -->
        <RemoveDir Directories="$(OutDir)wwwroot" Condition="'$(NuxtWasRegenerated)' == 'true'" />
        <ItemGroup>
            <NuxtWwwrootFiles Include="wwwroot\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(NuxtWwwrootFiles)"
              DestinationFiles="@(NuxtWwwrootFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- То же самое для dotnet publish: wwwroot исключён из None, поэтому
         добавляем файлы в список публикации вручную. -->
    <Target Name="AddNuxtWwwrootToPublish" AfterTargets="ComputeResolvedFilesToPublishList"
            DependsOnTargets="BuildNuxtFrontend">
        <ItemGroup>
            <NuxtWwwrootToPublish Include="wwwroot\**\*" />
            <ResolvedFileToPublish Include="@(NuxtWwwrootToPublish)"
                                   RelativePath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
                                   CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>
</Project>
